    "component_header": [
      {
        "_key": "4395e3cdfeea",
        "_type": "block",
        "children": [
          {
            "_key": "0a4470d0e5a7",
            "_type": "span",
            "marks": [],
            "text": "Who Is Eligible for the Bonus?"
          }
        ],
        "markDefs": [],
        "style": "normal"
      }
    ],
    "description": [
      {
        "_key": "941fd7e831aa",
        "_type": "block",
        "children": [
          {
            "_key": "67eb6dfc98a9",
            "_type": "span",
            "marks": [],
            "text": "The VeteranPCS Bonus is for current service members, veterans with an honorable discharge, and their spouses."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "6ef19fa2e510",
        "_type": "block",
        "children": [
          {
            "_key": "916e9e15f880",
            "_type": "span",
            "marks": [],
            "text": "You are eligible if you are:"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "d33c6b7e0007",
        "_type": "block",
        "children": [
          {
            "_key": "72930d6735aa",
            "_type": "span",
            "marks": [],
            "text": "Currently serving in the U.S. Armed Forces"
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "71154c3fedf4",
        "_type": "block",
        "children": [
          {
            "_key": "461bb645a23d",
            "_type": "span",
            "marks": [],
            "text": "A veteran who received an Honorable Discharge"
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "dc5826ae9c31",
        "_type": "block",
        "children": [
          {
            "_key": "9cd47317f0e8",
            "_type": "span",
            "marks": [],
            "text": "The spouse of someone who meets either one"
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "47254f186c04",
        "_type": "block",
        "children": [
          {
            "_key": "adbb35d4b61a",
            "_type": "span",
            "marks": [],
            "text": "Not a Service Member?"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "3cf8c63c637e",
        "_type": "block",
        "children": [
          {
            "_key": "bd84129b5d56",
            "_type": "span",
            "marks": [],
            "text": "You can still use the VeteranPCS service. Instead of receiving the bonus, the amount that would have gone to you is donated to a veteran-focused charity."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "1322af0a6009",
        "_type": "block",
        "children": [
          {
            "_key": "c45305c29f63",
            "_type": "span",
            "marks": [],
            "text": "There are penalties for falsely claiming you are a Service Member. Full details are in the "
          },
          {
            "_key": "173b8d49c972",
            "_type": "span",
            "marks": [
              "c7dcf6f8806e"
            ],
            "text": "Terms of Use"
          },
          {
            "_key": "4b15cf5b237a",
            "_type": "span",
            "marks": [],
            "text": "."
          }
        ],
        "markDefs": [
          {
            "_key": "c7dcf6f8806e",
            "_type": "link",
            "href": "/terms-of-use"
          }
        ],
        "style": "normal"
      }
    ],
    "header_slug": {
      "_type": "slug",
      "current": "who-is-eligible-for-the-move-in-bonus"
    }
  },
  {
    "_id": "117273c4-d4b5-44ef-954e-81b73dc6dbfe",
    "_type": "how_veterence_pcs_works",
    "_createdAt": "2024-12-18T10:37:32Z",
    "_updatedAt": "2026-07-20T00:00:00Z",
    "component_header": [
      {
        "_key": "bae76b4387e1",
        "_type": "block",
        "children": [
          {
            "_key": "e9e575bf08d1",
            "_type": "span",
            "marks": [],
            "text": "What Makes Us Different"
          }
        ],
        "markDefs": [],
        "style": "normal"
      }
    ],
    "description": [
      {
        "_key": "f1267cd19389",
        "_type": "block",
        "children": [
          {
            "_key": "905b024eba17",
            "_type": "span",
            "marks": [],
            "text": "VeteranPCS was designed to add value in three ways:"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "86d509f4448b",
        "_type": "block",
        "children": [
          {
            "_key": "3814ea8e242f",
            "_type": "span",
            "marks": [],
            "text": "We connect military families with agents who have personally PCSd."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "011c8e2decb4",
        "_type": "block",
        "children": [
          {
            "_key": "3115b3754257",
            "_type": "span",
            "marks": [],
            "text": "We help agents who are veterans or military spouses earn more clients."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "a85ce2d00dae",
        "_type": "block",
        "children": [
          {
            "_key": "c9eeb04a3f9c",
            "_type": "span",
            "marks": [],
            "text": "We give back to veteran-focused charities."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "ddaec6d9a47f",
        "_type": "block",
        "children": [
          {
            "_key": "3f9d93673551",
            "_type": "span",
            "marks": [],
            "text": "Reviews"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "61dd4b26115b",
        "_type": "block",
        "children": [
          {
            "_key": "41b2329c2971",
            "_type": "span",
            "marks": [],
            "text": "You will not see reviews listed for agents on this site."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "92c79b73de14",
        "_type": "block",
        "children": [
          {
            "_key": "f97a90dc45ce",
            "_type": "span",
            "marks": [],
            "text": "We interview and select every agent, and we verify their reviews. You do not need to sift through reviews to find a great agent."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "6593c9c4316b",
        "_type": "block",
        "children": [
          {
            "_key": "4ac7a8c4c9bd",
            "_type": "span",
            "marks": [],
            "text": "Every agent here was referred by a military client who bought or sold a house with them."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "a3e901a140b3",
        "_type": "block",
        "children": [
          {
            "_key": "dadc29e85c8f",
            "_type": "span",
            "marks": [],
            "text": "Review-based sites can make it hard for a veteran or military spouse to start a business. They charge high fees, make it hard to get noticed, and do not show which agents have real PCS experience."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "ab067f610ae5",
        "_type": "block",
        "children": [
          {
            "_key": "4cf2b72d5b0a",
            "_type": "span",
            "marks": [],
            "text": "If you want to see an agent’s reviews, you can get links to their personal websites once you contact them through the site."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "e0145629af61",
        "_type": "block",
        "children": [
          {
            "_key": "c088ae312c43",
            "_type": "span",
            "marks": [],
            "text": "Charities"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "39c65f86246f",
        "_type": "block",
        "children": [
          {
            "_key": "49793cfb81d7",
            "_type": "span",
            "marks": [],
            "text": "VeteranPCS is proud to support many veteran-focused charities and organizations. We donate an additional 10% of your VeteranPCS Bonus amount to a military-focused charity. See the bonus table above for amounts."
          }
        ],
        "markDefs": [],
        "style": "normal"
      }
    ],
    "header_slug": {
      "_type": "slug",
      "current": "what-makes-us-different"
    }
  },
  {
    "_id": "214430af-b230-46fa-99e2-0b4f50077952",
    "_type": "how_veterence_pcs_works",
