    "_updatedAt": "2026-07-20T00:00:00Z",
    "component_header": [
      {
        "_key": "5a36c67ad50a",
        "_type": "block",
        "children": [
          {
            "_key": "b22954e8ebc2",
            "_type": "span",
            "marks": [],
            "text": "How It Works for Mortgage Loan Officers"
          }
        ],
        "markDefs": [],
        "style": "normal"
      }
    ],
    "description": [
      {
        "_key": "35774511cc05",
        "_type": "block",
        "children": [
          {
            "_key": "7b64c4b92511",
            "_type": "span",
            "marks": [
              "em"
            ],
            "text": "This is a general overview of how our site works with mortgage loan officers, or VA Loan Experts. For full terms and conditions, refer to our Marketing Services Agreement."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "b87c19a53207",
        "_type": "block",
        "children": [
          {
            "_key": "f211d36f8ed9",
            "_type": "span",
            "marks": [],
            "text": "Who qualifies to be a VA Loan Expert?"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "3c5c338faac9",
        "_type": "block",
        "children": [
          {
            "_key": "a39227e83784",
            "_type": "span",
            "marks": [],
            "text": "To be featured as a VA Loan Expert on VeteranPCS, you must be one of the following:"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "b92d82c36ab9",
        "_type": "block",
        "children": [
          {
            "_key": "deeab8a46213",
            "_type": "span",
            "marks": [],
            "text": "Currently serving in the U.S. Armed Forces"
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "03843116b084",
        "_type": "block",
        "children": [
          {
            "_key": "53bc656eb0d0",
            "_type": "span",
            "marks": [],
            "text": "A veteran who received an Honorable Discharge"
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "3149d717652b",
        "_type": "block",
        "children": [
          {
            "_key": "6ba2f3e17091",
            "_type": "span",
            "marks": [],
            "text": "The spouse of someone who meets either one"
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "c1ce463a1677",
        "_type": "block",
        "children": [
          {
            "_key": "313c4eaec351",
            "_type": "span",
            "marks": [],
            "text": "You must also meet these requirements:"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "504d7e3ed159",
        "_type": "block",
        "children": [
          {
            "_key": "08c3365ff067",
            "_type": "span",
            "marks": [],
            "text": "You must be a licensed Mortgage Loan Officer in good standing."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "57755ca15085",
        "_type": "block",
        "children": [
          {
            "_key": "cb26c2e9638a",
            "_type": "span",
            "marks": [],
            "text": "You must not charge the 1% loan origination fee."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "f91bf8be2063",
        "_type": "block",
        "children": [
          {
            "_key": "39c4f46ac7bf",
            "_type": "span",
            "marks": [],
            "text": "Additional requirements are listed in the Marketing Services Agreement. If you are interested in becoming a VA Loan Expert, or if you do not meet the exact criteria above but believe you should be considered, please "
          },
          {
            "_key": "97a488180542",
            "_type": "span",
            "marks": [
              "92ebe749c3bd"
            ],
            "text": "contact us"
          },
          {
            "_key": "379573b3d5c6",
            "_type": "span",
            "marks": [],
            "text": " to discuss."
          }
        ],
        "markDefs": [
          {
            "_key": "92ebe749c3bd",
            "_type": "link",
            "href": "/contact"
          }
        ],
        "style": "normal"
      },
      {
        "_key": "0234240f46c4",
        "_type": "block",
        "children": [
          {
            "_key": "68aa1d8f9fee",
            "_type": "span",
            "marks": [],
            "text": "What does it cost?"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "a304c7844967",
        "_type": "block",
        "children": [
          {
            "_key": "6c138d02d95e",
            "_type": "span",
            "marks": [],
            "text": "VeteranPCS has an annual marketing fee for licensed mortgage lenders to be featured on the website. The fee is based on demand in each state and renews each calendar year."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "9f14763f9345",
        "_type": "block",
        "children": [
          {
            "_key": "a720a68dae60",
            "_type": "span",
            "marks": [],
            "text": "Use the Get Listed button on the "
          },
          {
            "_key": "8d467d8724f4",
            "_type": "span",
            "marks": [
              "33c910cbbd89"
            ],
            "text": "Contact Us page"
          },
          {
            "_key": "a739132c81b3",
            "_type": "span",
            "marks": [],
            "text": " to start the process and schedule a phone interview."
          }
        ],
        "markDefs": [
          {
            "_key": "33c910cbbd89",
            "_type": "link",
            "href": "/contact"
          }
        ],
        "style": "normal"
      },
      {
        "_key": "5daecf4edafe",
        "_type": "block",
        "children": [
          {
            "_key": "853cc38aa901",
            "_type": "span",
            "marks": [],
            "text": "Are you a lending company or bank?"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "8038038134ca",
        "_type": "block",
        "children": [
          {
            "_key": "c20927383acf",
            "_type": "span",
            "marks": [],
            "text": "No, we are not a mortgage broker, lending company, or bank. We feature veterans and military spouses who are licensed mortgage loan officers from many different companies across the nation."
          }
        ],
        "markDefs": [],
        "style": "normal"
      }
    ],
    "header_slug": {
      "_type": "slug",
      "current": "how-it-works-for-mortgage-loan-officers"
    }
