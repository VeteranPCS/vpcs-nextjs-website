        "style": "h3"
      },
      {
        "_key": "90cb5c59a3d1",
        "_type": "block",
        "children": [
          {
            "_key": "e0c99c16b0ae",
            "_type": "span",
            "marks": [],
            "text": "To be a Referral Partner with VeteranPCS, you must be one of the following:"
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "b8d6fc6420d6",
        "_type": "block",
        "children": [
          {
            "_key": "854837d59f6e",
            "_type": "span",
            "marks": [],
            "text": "Currently serving in the U.S. Armed Forces"
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "3929ca7cd952",
        "_type": "block",
        "children": [
          {
            "_key": "158ccee7a807",
            "_type": "span",
            "marks": [],
            "text": "A veteran who received an Honorable Discharge"
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "b659749c04b2",
        "_type": "block",
        "children": [
          {
            "_key": "856f90bdbb26",
            "_type": "span",
            "marks": [],
