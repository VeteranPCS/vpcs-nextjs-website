            "marks": [],
            "text": " to discuss."
          }
        ],
        "markDefs": [
          {
            "_key": "0420686c40a6",
            "_type": "link",
            "href": "/contact"
          }
        ],
        "style": "normal"
      },
      {
        "_key": "edaece56c6ce",
        "_type": "block",
        "children": [
          {
            "_key": "f0ae0ea3eccd",
            "_type": "span",
            "marks": [],
            "text": "What does it cost?"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "55d0106f5545",
        "_type": "block",
        "children": [
          {
            "_key": "0d155f2770bc",
            "_type": "span",
            "marks": [],
            "text": "VeteranPCS has no annual fees, no monthly fees, no fees for calls, and no hidden fees."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "f97ea9f98bad",
        "_type": "block",
        "children": [
          {
            "_key": "2a48e343c864",
            "_type": "span",
            "marks": [],
            "text": "We operate on a simple 30% referral fee of the gross commission for any customer who contacts you through VeteranPCS and closes on the sale or purchase of a home."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "277365408ff0",
        "_type": "block",
        "children": [
          {
            "_key": "3149e9cebeb3",
            "_type": "span",
            "marks": [],
            "text": "VeteranPCS distributes part of that 30% referral fee back to the Service Member at or after closing, when your state allows it. If a client is not a Service Member, we donate that would-be bonus to a veteran and military focused charity instead."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "e70cb070ba96",
        "_type": "block",
        "children": [
          {
            "_key": "4f646e5d7d69",
            "_type": "span",
            "marks": [],
            "text": "In states that do not allow giving money back at or after closing, VeteranPCS collects the standard 30% referral fee. In those states, we will consider the client, if a Service Member, for a Relocation Grant instead."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "6ed554c9a3a9",
        "_type": "block",
        "children": [
          {
            "_key": "3e72de1a96a4",
            "_type": "span",
            "marks": [],
            "text": "Are you a Brokerage?"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "ccd39d3badf1",
        "_type": "block",
        "children": [
          {
            "_key": "a213c46ced16",
            "_type": "span",
            "marks": [],
            "text": "VeteranPCS is a registered trade name for Solid Oak Realty, Inc., a Colorado corporation and real estate brokerage. Referral Partners are not employed by VeteranPCS. VeteranPCS features licensed real estate agents from many different brokerages."
          }
        ],
        "markDefs": [],
        "style": "normal"
      }
    ],
    "header_slug": {
      "_type": "slug",
      "current": "how-it-works-for-agents"
    }
  },
  {
    "_id": "4f9600b4-0e71-492e-a8ce-2b7036b7d844",
    "_type": "how_veterence_pcs_works",
    "_createdAt": "2024-12-18T09:24:06Z",
    "_updatedAt": "2026-07-20T00:00:00Z",
    "component_header": [
      {
        "_key": "74c06eeb1b8e",
        "_type": "block",
        "children": [
          {
            "_key": "49700c02ab6a0",
            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "How the VeteranPCS Service Works"
          }
        ],
        "markDefs": [],
        "style": "normal"
      }
    ],
    "description": [
      {
        "_key": "59c8fc14fb93",
        "_type": "block",
        "children": [
          {
            "_key": "7ff67242d8a2",
            "_type": "span",
            "marks": [],
            "text": "The VeteranPCS service is "
          },
          {
            "_key": "d7b201c03fb5",
            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "free to use"
          },
          {
            "_key": "3776475f21d3",
            "_type": "span",
            "marks": [],
            "text": "."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "53a56691d06c",
        "_type": "block",
        "children": [
          {
            "_key": "9e4cc7abba43",
            "_type": "span",
            "marks": [],
            "text": "Your agent pays VeteranPCS a "
          },
          {
            "_key": "db7393857a92",
            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "30% referral fee"
          },
          {
            "_key": "99ac09d4871a",
            "_type": "span",
            "marks": [],
            "text": " at closing."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "cfec18b67a93",
        "_type": "block",
        "children": [
          {
            "_key": "44f2c3aed58c",
            "_type": "span",
            "marks": [],
            "text": "You receive a "
          },
          {
            "_key": "8dab3252a5d4",
            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "Move-In or Military Bonus"
          },
          {
            "_key": "015cc1f258b6",
            "_type": "span",
            "marks": [],
            "text": " of $200 to $4,000 when your state allows it."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "34997dcc3f3d",
        "_type": "block",
        "children": [
          {
            "_key": "d61148d53d58",
            "_type": "span",
            "marks": [],
            "text": "10% of your bonus amount also goes to "
          },
          {
            "_key": "093e558215ec",
            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "military charities"
          },
          {
            "_key": "735ef7a95f64",
            "_type": "span",
            "marks": [],
            "text": "."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "76e016603d23",
        "_type": "block",
        "children": [
          {
            "_key": "4f998846f3c0",
            "_type": "span",
            "marks": [],
            "text": "What does it cost?"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "df93486611b3",
        "_type": "block",
        "children": [
          {
            "_key": "78f7f711ecea",
            "_type": "span",
            "marks": [],
            "text": "The VeteranPCS service is free to use. Your agent pays VeteranPCS a referral fee. The fee comes out of the commission they earn when you buy or sell a home through the site."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "d20938f60a56",
        "_type": "block",
        "children": [
          {
            "_key": "b960a7f305be",
            "_type": "span",
            "marks": [],
            "text": "VeteranPCS then shares part of that referral fee with you as your VeteranPCS Bonus at or after closing."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "9a18f35dfd11",
        "_type": "block",
        "children": [
          {
            "_key": "05c4536f638f",
            "_type": "span",
            "marks": [],
            "text": "Connecting with an agent"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "6fcf62d91e84",
        "_type": "block",
        "children": [
          {
            "_key": "1e3bca14884d",
            "_type": "span",
            "marks": [],
            "text": "You can "
          },
          {
            "_key": "b9f39f0fecab",
            "_type": "span",
            "marks": [
              "12036badc983"
            ],
            "text": "browse agents by state"
          },
          {
            "_key": "f2f9958de738",
            "_type": "span",
            "marks": [],
            "text": " and contact them through the website. Click the “Get in Contact” button and fill out a short form to connect with that agent."
          }
        ],
        "markDefs": [
          {
            "_key": "12036badc983",
            "_type": "link",
            "href": "#agent-map"
          }
        ],
        "style": "normal"
      },
      {
        "_key": "9ec83ce7b8bd",
        "_type": "block",
        "children": [
          {
            "_key": "9e9166de8f31",
            "_type": "span",
            "marks": [],
            "text": "Your information is "
          },
          {
            "_key": "932ff06dc7e3",
            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "never shared or sold"
          },
          {
            "_key": "aa156b004da4",
            "_type": "span",
            "marks": [],
            "text": ". The only purpose of the form is to connect you with that agent."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "253df0b77737",
        "_type": "block",
        "children": [
          {
            "_key": "64082d65313d",
            "_type": "span",
            "marks": [],
            "text": "When you submit the form, you receive an auto-email with that agent’s contact information. The agent receives an email with your information. You can start talking right away."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "c74334ad4d20",
        "_type": "block",
        "children": [
          {
            "_key": "8a1d25fe8ede",
            "_type": "span",
            "marks": [],
            "text": "If you sign an agency agreement with an agent, that contract happens outside the website. VeteranPCS is not a party to it."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "4be4d02b1ebb",
        "_type": "block",
        "children": [
          {
            "_key": "86be0cd9062c",
            "_type": "span",
            "marks": [],
            "text": "You "
          },
          {
            "_key": "8b056db7002b",
            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "must agree to receive periodic communications"
          },
          {
            "_key": "c246310f1e55",
            "_type": "span",
            "marks": [],
            "text": " from us to use the service and receive the VeteranPCS Bonus. We track key dates to make sure you receive your bonus."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "7aa332f8c45f",
        "_type": "block",
        "children": [
          {
            "_key": "90ce17a48de6",
            "_type": "span",
            "marks": [],
            "text": "Interviewing agents"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "57f21633b677",
        "_type": "block",
        "children": [
          {
            "_key": "280b7ab31dc8",
            "_type": "span",
            "marks": [],
            "text": "Fill out forms for as many agents as you like. Interview them yourself and pick the one who fits you best."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "c44f78880166",
        "_type": "block",
        "children": [
          {
            "_key": "8f99d081d758",
            "_type": "span",
            "marks": [],
            "text": "Agents are not entitled to every lead from the website. You choose your agent. VeteranPCS tells each agent your decision so communication stays clear."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "fd7bd6c82420",
        "_type": "block",
        "children": [
          {
            "_key": "69eff3b9dc89",
            "_type": "span",
            "marks": [],
            "text": "Already signed a valid agency agreement with another agent? VeteranPCS is not a party to that contract and will not attempt to break it."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "48da442be2b7",
        "_type": "block",
        "children": [
          {
            "_key": "25e216ce1f3e",
            "_type": "span",
            "marks": [],
            "text": "Follow up"
          }
        ],
        "markDefs": [],
        "style": "h3"
      },
      {
        "_key": "1813b952ffb9",
        "_type": "block",
        "children": [
          {
            "_key": "02b6494254c7",
            "_type": "span",
            "marks": [],
            "text": "We keep in contact with you and your agent through the whole process. We want to be sure you receive the quality of service we expect from every agent on VeteranPCS."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
        "_key": "a91363d226fe",
        "_type": "block",
        "children": [
          {
            "_key": "ead8f7009fe3",
            "_type": "span",
            "marks": [],
            "text": "If you are ever dissatisfied with the level of service, let us know. We will investigate and may suspend that agent’s use of our services."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      },
      {
        "_key": "d4ff694b0aeb",
        "_type": "block",
        "children": [
          {
            "_key": "85e86b965586",
            "_type": "span",
            "marks": [],
            "text": "When you close on your home, your agent pays VeteranPCS a 30% referral fee from their total commission. VeteranPCS then sends your VeteranPCS Bonus to you if your state allows it (see How the VeteranPCS Bonus Works)."
          }
        ],
        "markDefs": [],
        "style": "normal",
        "level": 1,
        "listItem": "bullet"
      }
    ],
    "header_slug": {
      "_type": "slug",
      "current": "how-the-veteranpcs-service-works"
    }
