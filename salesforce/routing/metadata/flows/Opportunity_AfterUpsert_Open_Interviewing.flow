                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Interviewing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Closed_Lost</targetReference>
            </connector>
