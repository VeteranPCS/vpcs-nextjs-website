    <decisions>
        <name>Type</name>
        <label>Type</label>
        <locationX>314</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Interviewing_Stage_Agent</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Agent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Interviewing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Welcome_to_Agent</targetReference>
            </connector>
            <label>Interviewing Stage. (Agent)</label>
        </rules>
        <rules>
            <name>Lender_Interviewing</name>
            <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lender</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Interviewing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Lender_Alert_NS</targetReference>
            </connector>
            <label>Lender-Interviewing</label>
        </rules>
    </decisions>
    <description>v3 : add lost reason
add 7 days to each scheduled path
In addition to the current one. Created from AfterInsert, to accommodate intern stage getting converted to interview stage</description>
    <environments>Default</environments>
    <formulas>
        <name>Guard_Routing_Migration_Check</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Permission.VPCS_Routing_Migration},ISCHANGED({!$Record.OwnerId}))</expression>
    </formulas>
    <formulas>
        <name>isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Opportunity. AfterUpsert. Open+Interviewing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity. AfterUpsert. Open+Interviewing</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Closed_Lost</name>
        <label>Set Closed-Lost</label>
        <locationX>2162</locationX>
        <locationY>384</locationY>
        <inputAssignments>
            <field>Loss_Reason_Details__c</field>
            <value>
                <stringValue>Auto-Closed via Flow: Opportunity. AfterUpsert. Open+Interviewing</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Loss_Reason__c</field>
            <value>
                <stringValue>No Decision / Non-Responsive</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Closed - Lost</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>1178</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Guard_Routing_Migration</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>X1stReminder</name>
            <connector>
                <targetReference>AppReceived</targetReference>
            </connector>
            <label>1stReminder</label>
            <offsetNumber>14</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Interviewing_Stage_Timestamp__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>X2ndReminder</name>
            <connector>
                <targetReference>AppReceived_0</targetReference>
            </connector>
            <label>2ndReminder</label>
            <offsetNumber>21</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Interviewing_Stage_Timestamp__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>Auto_Close</name>
            <connector>
                <targetReference>AppReceived_0_0</targetReference>
            </connector>
            <label>Auto-Close</label>
            <offsetNumber>24</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>Interviewing_Stage_Timestamp__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>body</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hello {!$Record.Account.PersonContact.FirstName}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Great talking with you today, and thanks for your interest in VeteranPCS. Here is the next step, an application that includes the bio and headshot submission. There is a place to list your two previous military client references as well as any other agents that you know or have done referrals with that you think would be a good fit for this site.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Below is also the contract to review, I will send through docusign once we go through the submitted application - so this copy is just for ease of reading for you and your brokerage.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://forms.gle/uRWcsCDdQ3qN1KNY6" rel="noopener noreferrer" target="_blank" style="color: rgb(17, 85, 204);"&gt;VeteranPCS Agent Application Google Form&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://drive.google.com/file/d/1DHRGUdJZFslUD6B1TiERPXZw8fWSFQn2/view?usp=sharing" rel="noopener noreferrer" target="_blank" style="color: rgb(17, 85, 204);"&gt;VeteranPCS Referral Agreement (Read Only)&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Let me know if you have any questions, Thanks!&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;--&lt;/p&gt;&lt;p&gt;&lt;span style="font-family: tahoma, sans-serif;"&gt;Best Regards,&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b style="font-family: tahoma, sans-serif;"&gt;Jason Anderson&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="font-family: tahoma, sans-serif;"&gt;Founder &amp;amp; CEO,&amp;nbsp;VeteranPCS&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="font-family: tahoma, sans-serif; color: rgb(102, 102, 102);"&gt;Web:&amp;nbsp;&lt;/span&gt;&lt;a href="http://www.veteranpcs.com/" rel="noopener noreferrer" target="_blank" style="font-family: tahoma, sans-serif; color: rgb(102, 102, 102);"&gt;www.VeteranPCS.com&lt;/a&gt;&lt;span style="font-family: tahoma, sans-serif; color: rgb(102, 102, 102);"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="font-family: tahoma, sans-serif; color: rgb(102, 102, 102);"&gt;Email:&amp;nbsp;&lt;/span&gt;&lt;a href="mailto:janderson@veteranpcs.com" rel="noopener noreferrer" target="_blank" style="font-family: tahoma, sans-serif; color: rgb(102, 102, 102);"&gt;janderson@veteranpcs.com&lt;/a&gt;&lt;span style="font-family: tahoma, sans-serif; color: rgb(102, 102, 102);"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="font-family: tahoma, sans-serif; color: rgb(102, 102, 102);"&gt;Mobile: (719) 445-1843&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://www.facebook.com/VeteranPCS" rel="noopener noreferrer" target="_blank" style="color: rgb(17, 85, 204);"&gt;Facebook&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://www.linkedin.com/company/veteranpcs" rel="noopener noreferrer" target="_blank" style="color: rgb(17, 85, 204);"&gt;LinkedIn&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a href="https://www.instagram.com/veteranpcs/" rel="noopener noreferrer" target="_blank" style="color: rgb(17, 85, 204);"&gt;Instagram&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="font-family: tahoma, sans-serif;"&gt;______________________&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="font-family: tahoma, sans-serif; color: rgb(102, 102, 102);"&gt;Real Estate Broker Associate&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="font-family: tahoma, sans-serif; color: rgb(102, 102, 102);"&gt;RE/MAX Integrity, Inc.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style="font-family: tahoma, sans-serif; color: rgb(102, 102, 102);"&gt;Colorado Springs, CO&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;img src="https://ci3.googleusercontent.com/proxy/3eieYBZGn2RfmlmwihqDrt1tQ5lkJOdD8Kyy3HSJHnfW2CE8_XyacyB2scbRr4Sw4JFDPBpvQNWX49zrRDOhcbVxnnSiYWWvsJAQ957XlVJnt9Y2R-zVneaoODvO_iQlbP0TTazNOvgb7JZtqdhtx-43I0bsfabxFxms81IYAXXRzKQdoKaYfcArTO3nxqbrfoWViP8bRCKgSRnXlw=s0-d-e1-ft#https://docs.google.com/uc?export=download&amp;amp;id=1o8FebTizlFSoM6WOnn_zvVJiS6P2aOxx&amp;amp;revid=0B3kpSDMiPB_BbjBKcHBiOCswUExVY3E5U1llQ0xuUnowenM4PQ"&gt;&lt;/p&gt;</text>
    </textTemplates>
    <triggerOrder>1500</triggerOrder>
