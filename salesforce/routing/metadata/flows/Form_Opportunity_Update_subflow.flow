    <apiVersion>64.0</apiVersion>
    <assignments>
        <name>Copy_2_of_Persist_the_settings_record_so_we_can_refer_to_it_later</name>
        <label>Persist the settings record so we can refer to it later</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_OppActionSettings</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_a_new_Opp_Stage_mapping_from_Existing_Status</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Next_Contact_Date</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Initialize a new Opp variable that will be used to store updated values</description>
        <name>Init_Updated_Opp</name>
        <label>Init Updated Opp</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_OppToUpdate.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>VAR_TriggeringForm.Opportunity__r.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Opp_Status_mapping</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Keep_existing_Opp_Stage</name>
        <label>Keep existing Opp Stage</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_OppToUpdate.StageName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_existing_Opp.StageName</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_a_new_Opp_Stage_mapping_from_Existing_Status</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Persist_new_Next_Contact_Date</name>
        <label>Persist new Next Contact Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_OppToUpdate.Next_Contact_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Set_Next_Contact_Date.VAR_OppToUpdate.Next_Contact_Date__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Should_send_Admin_alert</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Persist_the_settings_record_so_we_can_refer_to_it_later</name>
        <label>Persist the settings record so we can refer to it later</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_OppActionSettings</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opp_Status_mapping</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_SendAdminEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Opp_Status_mapping.Send_Admin_Email_c__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Need_to_preserve_current_Opp_Stage</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Note_Fields</name>
        <label>Set Note Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_New_EnhancedNote.Title</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>An Opp Update form was submitted.</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_New_EnhancedNote.Content</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>FOR_NoteContents</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_a_Note</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Target_Opp_Stage_from_settings</name>
        <label>Set Target Opp Stage from settings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_OppToUpdate.StageName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>VAR_OppActionSettings.Target_Opp_Stage__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Next_Contact_Date</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Just in case someone tries to call this flow elsewhere, it won't work if it's not a Opp Update Form__c</description>
        <name>Is_Triggering_Form_a_Opp_Update</name>
        <label>Is Triggering Form a Opp Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_TriggeringForm.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp_Update</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Init_Updated_Opp</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Need_to_preserve_current_Opp_Stage</name>
        <label>Need to preserve current Opp Stage?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Target_Opp_Stage_from_settings</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, Set target</defaultConnectorLabel>
        <rules>
            <name>PreserveOppStatus_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_OppActionSettings.Action_On_Opp_Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Preserve_Current</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_existing_Opp</targetReference>
            </connector>
            <label>Yes, Preserve Status</label>
        </rules>
    </decisions>
    <decisions>
        <description>Compares the first value we got from the original settings and the current value. If either one of them requested an email alert, then we should send it.</description>
        <name>Should_send_Admin_alert</name>
        <label>Should send Admin alert?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Triggering_Opp</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>SendAdminAlert_Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>VAR_OppActionSettings.Send_Admin_Email_c__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>VAR_SendAdminEmail</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_TEST_Admin_email</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Use_TEST_Admin_email</name>
        <label>Use TEST Admin email?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Resolve_Regional_Admin_Recipients</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_use_test</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_UseTestAdminEmail</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_KNAPPTECH_admin_alert</targetReference>
            </connector>
            <label>Yes, use test</label>
        </rules>
    </decisions>
    <description>Handle the Opp_Update Form__c record type when created.</description>
    <environments>Default</environments>
    <formulas>
        <name>FOR_14DaysDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+14</expression>
    </formulas>
    <formulas>
        <name>FOR_30DaysDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+30</expression>
    </formulas>
    <formulas>
        <name>FOR_7DaysDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+7</expression>
    </formulas>
    <formulas>
        <name>FOR_EmailSubject</name>
        <dataType>String</dataType>
        <expression>"Alert: " &amp; {!FOR_NewStatusText}</expression>
    </formulas>
    <formulas>
        <name>FOR_NewStatusText</name>
        <dataType>String</dataType>
        <expression>TEXT({!VAR_TriggeringForm.Lead_Status__c})</expression>
    </formulas>
    <formulas>
        <description>Build note content from Comments, Stages, and other properties.</description>
        <name>FOR_NoteContents</name>
        <dataType>String</dataType>
        <expression>IF({!VAR_TriggeringForm.Opp_Current_Stage__c} = TEXT({!VAR_OppToUpdate.StageName}), 'Status unchanged: ', 'Agent updated the status to: ') + TEXT({!VAR_OppToUpdate.StageName}) + '. ' + BR() + {!VAR_TriggeringForm.Comments__c}</expression>
    </formulas>
    <formulas>
        <name>FOR_TomorrowDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+1</expression>
    </formulas>
    <interviewLabel>Form: Opportunity Update subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Form: Opportunity Update subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Add_a_Note</name>
        <label>Add a Note</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_the_ContentDocumentLink</targetReference>
        </connector>
        <inputReference>VAR_New_EnhancedNote</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_the_ContentDocumentLink</name>
        <label>Create the ContentDocumentLink</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ContentDocumentId</field>
            <value>
                <elementReference>VAR_New_EnhancedNote.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LinkedEntityId</field>
            <value>
                <elementReference>VAR_TriggeringForm.Opportunity__r.Id</elementReference>
            </value>
        </inputAssignments>
        <object>ContentDocumentLink</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <description>** This searches the mapping settings by Target Opp Stage which is the actual Opp.Stage value (not the incoming value from the Form). there will be multiple matches but hopefully, they all have the same Next contact date and Send Adming flag values. This is why we only retrieve the first record.</description>
        <name>Get_a_new_Opp_Stage_mapping_from_Existing_Status</name>
        <label>Get a new Opp Stage mapping from Existing Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Copy_2_of_Persist_the_settings_record_so_we_can_refer_to_it_later</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Target_Opp_Stage__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>VAR_OppToUpdate.StageName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Form_Opp_Stage_Mapping__mdt</object>
        <sortField>Target_Opp_Stage__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_existing_Opp</name>
        <label>Get existing Opp</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Keep_existing_Opp_Stage</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>VAR_OppToUpdate.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Opp_Status_mapping</name>
        <label>Get Opp Status mapping</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Persist_the_settings_record_so_we_can_refer_to_it_later</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Source_Form_Opp_Stage__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>VAR_TriggeringForm.Opp_Stage__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Form_Opp_Stage_Mapping__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Triggering_Opp</name>
        <label>Update Triggering Opp</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Note_Fields</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>VAR_TriggeringForm.Opportunity__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Next_Contact_Date__c</field>
            <value>
                <elementReference>VAR_OppToUpdate.Next_Contact_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <elementReference>VAR_OppToUpdate.StageName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Updated_by_Agent_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Triggering_Form_a_Opp_Update</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Set_Next_Contact_Date</name>
        <label>Set Next Contact Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Persist_new_Next_Contact_Date</targetReference>
        </connector>
        <flowName>SUB_Set_Next_Contact_Date_on_Opp</flowName>
        <inputAssignments>
            <name>VAR_OppActionSettings</name>
            <value>
                <elementReference>VAR_OppActionSettings</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>VAR_OppToUpdate</name>
            <value>
                <elementReference>VAR_OppToUpdate</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>VAR_LeadActionSettings</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Form_Lead_Status_Mapping__mdt</objectType>
    </variables>
    <variables>
        <name>VAR_LeadToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>VAR_New_EnhancedNote</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContentNote</objectType>
    </variables>
    <variables>
        <name>VAR_OppActionSettings</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Form_Opp_Stage_Mapping__mdt</objectType>
    </variables>
    <variables>
        <name>VAR_OppToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Opportunity</objectType>
    </variables>
    <variables>
        <description>When preserving the original Lead.Status we may still want to send an Admin Email. The current Lead.Status may not trigger an email, but the original Form option should have. We'll persiste the original value here and compare it later.</description>
        <name>VAR_SendAdminEmail</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>The Form__c record that's triggering this subflow</description>
        <name>VAR_TriggeringForm</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Form__c</objectType>
    </variables>
    <variables>
        <name>VAR_UseTestAdminEmail</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
