<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Resolve_Regional_Admin_Recipients</name>
        <label>Resolve Regional Admin Recipients</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>VpcsRegionalAdminEmailRecipients</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Send_Lead_Accepted_Alert</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customerId</name>
            <value>
                <elementReference>VAR_TriggeringForm.Lead__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>operationalCopy</name>
            <value>
                <stringValue>admin@veteranpcs.com,info@veteranpcs.com</stringValue>
            </value>
        </inputParameters>
        <nameSegment>VpcsRegionalAdminEmailRecipients</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <description>Sends the dedicated "lead accepted" admin notification. Looked up by DeveloperName rather than a hardcoded Id, since the template's Id isn't known until it's deployed.</description>
        <name>Send_Lead_Accepted_Alert</name>
        <label>Send Lead Accepted Alert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Resolve_Regional_Admin_Recipients.addresses</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <stringValue>info@veteranpcs.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>useEmailTemplate</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailTemplateId</name>
            <value>
                <elementReference>Get_Lead_Accepted_Email_Template.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientId</name>
            <value>
                <stringValue>003Rg00000Vd32cIAB</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>relatedRecordId</name>
            <value>
                <elementReference>VAR_TriggeringForm.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>1.0.1</versionString>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <decisions>
        <description>Add one rule per status that needs its own dedicated, template-based email alert. Anything not matched here falls through and sends nothing.</description>
        <name>Which_Status_Specific_Alert</name>
        <label>Which Status Specific Alert?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No matching alert</defaultConnectorLabel>
        <rules>
            <name>AcceptLead</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_TriggeringForm.Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AcceptLead</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Lead_Accepted_Email_Template</targetReference>
            </connector>
            <label>AcceptLead</label>
        </rules>
    </decisions>
    <description>Sends a dedicated, template-based email alert for specific Form Lead Status values (gated by Form_Lead_Status_Mapping__mdt.Send_Status_Specific_Email_Alert__c). Add a new rule to Which_Status_Specific_Alert for each additional status that needs its own alert.</description>
    <environments>Default</environments>
    <interviewLabel>SUB: Send Lead Status Specific Email Alert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SUB: Send Lead Status Specific Email Alert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Lead_Accepted_Email_Template</name>
        <label>Get Lead Accepted Email Template</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Resolve_Regional_Admin_Recipients</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Admin_Lead_Accepted_Alert</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EmailTemplate</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Which_Status_Specific_Alert</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>The Form__c record that triggered this subflow</description>
        <name>VAR_TriggeringForm</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Form__c</objectType>
    </variables>
</Flow>
