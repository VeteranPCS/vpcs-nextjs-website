<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Calculate_Payout_amt</name>
        <label>Calculate Payout amt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Payout_Amount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_payoutAmt</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>set_Net_Revenue_amount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>set_email_fields_Account_related_Lender_related_Agent</name>
        <label>set email fields (Account, related Lender, related Agent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Person_Account_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Account.PersonEmail</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Related_Lender_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_relatedLenderEmail</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Related_Agent_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_relatedAgentEmail</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Record_Type_check</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>set_Net_Revenue_amount</name>
        <label>set Net Revenue amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Amount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>f_Net_Comission_Amount</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Opp_to_Intern_0</name>
        <label>Set Opp to Intern</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.StageName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Internship</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Intern__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Stage</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Opp_to_Interviewing</name>
        <label>Set Opp to Interviewing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.StageName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Interviewing</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Stage</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Opp_to_Tracking</name>
        <label>Set Opp to Tracking</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.StageName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Tracking</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Stage</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>set_PayoutAmt_var</name>
        <label>set Payout Amount var</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_payoutAmt</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Payout_Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>set_Net_Revenue_amount</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>set_Phone_Call_Interview_App_Sent_fields</name>
        <label>set Phone Call, Interview, App Sent... fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Set_up_initial_Phone_Call__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Phone_Interview_Complete__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Application_Sent_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Interviewing_Stage_Timestamp__c</assignToReference>
            <operator>Assign</operator>
