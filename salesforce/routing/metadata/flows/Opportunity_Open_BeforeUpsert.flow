                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Lead_Type</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Guard_Routing_Migration</name>
        <label>Routing Migration</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Bypass_Flows_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Continue</defaultConnectorLabel>
        <rules>
            <name>Routing_Migration_Transfer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Guard_Routing_Migration_Check</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Stop</label>
        </rules>
    </decisions>
    <decisions>
        <name>Bypass_Flows_Check</name>
        <label>Bypass Flows?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>set_email_fields_Account_related_Lender_related_Agent</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Bypass</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Bypass_Flows</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Bypass</label>
        </rules>
    </decisions>
    <decisions>
        <name>Lead_Type</name>
        <label>Lead Type?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Payout_Amt</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Intern_IsNew</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Type__pc</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Intern</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>f_isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Intern+IsNew</label>
        </rules>
        <rules>
            <name>Lender_Opp</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Lender</stringValue>
                </rightValue>
            </conditions>
            <label>Lender Opp</label>
        </rules>
    </decisions>
    <decisions>
        <name>Record_Type_check</name>
        <label>Record Type check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_Type_Intern</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Type__pc</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Intern</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>f_isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Opp_to_Intern_0</targetReference>
            </connector>
            <label>Account Type Intern</label>
        </rules>
        <rules>
            <name>OppType_Customer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>f_isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Opp_to_Tracking</targetReference>
            </connector>
            <label>Customer?</label>
        </rules>
        <rules>
            <name>OppType_Agent_or_Lender</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>f_isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Agent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lender</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Opp_to_Interviewing</targetReference>
            </connector>
            <label>Agent or Lender?</label>
        </rules>
    </decisions>
    <decisions>
        <name>Set_Payout_Amt</name>
        <label>Set Payout Amt</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Calculate_Payout_amt</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Manually_Changed</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4 AND 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payout_Amount__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Payout_Amount__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Payout_Amount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Payout_Amount__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>f_payoutAmt</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Payout_Amount__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sale_Price__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Sale_Price__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_PayoutAmt_var</targetReference>
            </connector>
            <label>No, Manually Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Stage</name>
        <label>Stage?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Lead_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Set_Interviewing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Interviewing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_Phone_Call_Interview_App_Sent_fields</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Set-&gt;Interviewing</label>
        </rules>
    </decisions>
    <description>just changed some naming to standards</description>
    <environments>Default</environments>
    <formulas>
        <name>Guard_Routing_Migration_Check</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Permission.VPCS_Routing_Migration},ISCHANGED({!$Record.OwnerId}))</expression>
    </formulas>
    <formulas>
        <name>f_expectedGCI</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!$Record.Closing_Commission__c}),{!$Record.Closing_Commission_Amt__c} ,{!$Record.Sale_Price__c}*{!$Record.Closing_Commission__c}) * {!$Record.Referral_Split__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>f_isNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>f_managingBrokerAmt</name>
        <dataType>Currency</dataType>
        <expression>{!$Record.Managing_Brokerage_percent__c} * BLANKVALUE({!$Record.Actual_GCI__c},{!f_expectedGCI})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Calculates the net GCI after subtracting managing broker amount, agent payout, and charity contribution. Defaults to expected GCI if actual GCI is blank.</description>
        <name>f_Net_Comission_Amount</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!$Record.Actual_GCI__c},{!f_expectedGCI}) - {!f_managingBrokerAmt} - BLANKVALUE({!VAR_payoutAmt},{!f_payoutAmt}) - BLANKVALUE({!$Record.Charity_Amount__c},0)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>formula for the payout amount</description>
        <name>f_payoutAmt</name>
        <dataType>Currency</dataType>
        <expression>IF( {!$Record.Sale_Price__c} &gt;= 1000000,4000,
IF( {!$Record.Sale_Price__c} &gt;= 750000,3000,
IF( {!$Record.Sale_Price__c} &gt;= 600000,2000,
IF( {!$Record.Sale_Price__c} &gt;= 500000,1500,
IF( {!$Record.Sale_Price__c} &gt;= 400000,1200,
IF( {!$Record.Sale_Price__c} &gt;= 300000,1000,
IF( {!$Record.Sale_Price__c} &gt;= 200000,700,
IF( {!$Record.Sale_Price__c} &gt;= 100000,400,
IF( {!$Record.Sale_Price__c} &gt; 0,200,null)))))))))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>f_relatedAgentEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Agent__c}),"",{!$Record.Agent__r.PersonEmail})</expression>
    </formulas>
    <formulas>
        <name>f_relatedLenderEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Lender__c}),"",{!$Record.Lender__r.PersonEmail})</expression>
    </formulas>
    <interviewLabel>Opportunity. Open. BeforeUpsert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity. Open. BeforeUpsert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Guard_Routing_Migration</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>VAR_payoutAmt</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
