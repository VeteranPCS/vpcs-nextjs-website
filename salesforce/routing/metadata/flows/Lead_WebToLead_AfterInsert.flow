    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Guard_Regional_Intake</name>
        <label>Regional Contact Intake Guard</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Alert_ISA_Admin_0_0_0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Continue</defaultConnectorLabel>
        <rules>
            <name>Routing_Intake_Handled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Guard_Regional_Intake_Check</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Stop</label>
        </rules>
    </decisions>
    <decisions>
        <name>Type</name>
        <label>Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Type0</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default (Customer)</defaultConnectorLabel>
        <rules>
            <name>Agent_Referred</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Agent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Referred_By_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Referred_By_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Response_to_Referrer</targetReference>
            </connector>
            <label>Agent (Referred)</label>
        </rules>
        <rules>
            <name>Agent_Direct</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Agent</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Alert_ISA_Admin</targetReference>
            </connector>
            <label>Agent (Direct)</label>
        </rules>
        <rules>
            <name>Lender_Direct</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lender</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>send_Lender_Welcome</targetReference>
            </connector>
            <label>Lender (Direct)</label>
        </rules>
        <rules>
            <name>Intern</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Type__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Intern</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Intern</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>alert_intern</targetReference>
            </connector>
            <label>Intern</label>
        </rules>
    </decisions>
    <decisions>
        <description>is the agent or lender assigned or neither</description>
        <name>Type0</name>
        <label>Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Customer_Prospect</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Prospect</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Guard_Regional_Intake</targetReference>
            </connector>
            <label>Customer-Prospect</label>
        </rules>
        <rules>
            <name>Agent_Assigned_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Agent__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Alert_Agent_V2</targetReference>
            </connector>
            <label>Agent Assigned</label>
        </rules>
        <rules>
            <name>Lender_Assigned</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lender__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Alert_Lender</targetReference>
            </connector>
            <label>Lender Assigned</label>
        </rules>
        <rules>
            <name>Contact_Agent_Form_no_Agent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WebFormURL__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>contact-agent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Agent__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Alert_Customer_0_0</targetReference>
            </connector>
            <label>Contact Agent Form, no Agent</label>
        </rules>
        <rules>
            <name>Contact_Lender_Form_no_Lender</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WebFormURL__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>contact-lender</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Lender__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Welcome_Customer</targetReference>
            </connector>
            <label>Contact Lender Form, no Lender</label>
        </rules>
        <rules>
            <name>Buying_Selling_no_Agent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Buying_andor_Selling__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Agent__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Alert_Customer_0_0</targetReference>
            </connector>
            <label>Buying/Selling no Agent</label>
        </rules>
        <rules>
            <name>No_Lender_Contact_Form</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Lender__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Buying_andor_Selling__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Destination_Base__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Welcome_Customer</targetReference>
            </connector>
            <label>No Lender; Contact Form</label>
        </rules>
    </decisions>
    <description>v17 : portal rollout to all agents. Removed the single pilot-agent branch (CONST_TestAgentAccountId); every assigned agent now gets Alert_Agent_V2 + the new-lead SMS, which is skipped when the agent has no phone. The original Alert_Agent (Lead.New_Lead_Alert_to_Agent) is no longer sent from this flow.
v16 : moved the 30m/5D scheduled paths (Type_check/Type_Status_check/SE_Welcome_Video/Send_Squared_Away_Alert) to Lead_WebToLead_Customer_Scheduled_AfterInsert, which is scoped to RecordType.DeveloperName = 'Customer' at Start. That logic only ever acted on Customer-type leads, but the scheduled path itself was queued for every WebToLead lead regardless of record type, leaving Agent/Lender/Intern leads holding a pending time-based scheduled action (blocking operations like Lead Convert) for up to 5 days for no reason.
v15 : auto email #57
v14 : have path for 'Prospect' Customer
v13 : improvement for simplified form to send proper email
v11 : add scheduled path for welcome video to Customer; v12 with status "New..."
add track for customer w lender
add track for lender
add track for referred agent</description>
    <environments>Default</environments>
    <formulas>
        <name>Guard_Regional_Intake_Check</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Record.RecordType.DeveloperName}="Customer",OR(AND(ISPICKVAL({!$Record.LeadSource},"Contact Agent"),REGEX(LOWER({!$Record.WebFormURL__c}),"^https?://[^/?#]+/contact-agent/?([?#].*)?$")),AND(ISPICKVAL({!$Record.LeadSource},"Contact Lender"),REGEX(LOWER({!$Record.WebFormURL__c}),"^https?://[^/?#]+/contact-lender/?([?#].*)?$"))))</expression>
    </formulas>
    <formulas>
        <name>tomorrow</name>
        <dataType>Date</dataType>
        <expression>TODAY()+1</expression>
    </formulas>
    <interviewLabel>Lead. WebToLead. AfterInsert. {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead : WebToLead : AfterInsert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Task_0</name>
        <label>Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ActivityDate</field>
            <value>
                <elementReference>tomorrow</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>Reach out to new Lead</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhoId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <description>Initializes the Speed-to-Lead debounce timestamp at the moment the initial New Lead alert is sent, so AgentPortalReminderBatch's 1-hour cutoff is measured from now instead of treating the lead as immediately overdue for a reminder.</description>
        <name>Set_Initial_Speed_To_Lead_Reminder_Timestamp</name>
        <label>Set Initial Speed To Lead Reminder Timestamp</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Alert_Customer</targetReference>
        </connector>
        <inputAssignments>
            <field>Last_Speed_To_Lead_Reminder__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WebToLead__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
