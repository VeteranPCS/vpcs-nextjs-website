<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>51.0</apiVersion>
    <assignments>
        <name>Remove_Next_Contact_Date</name>
        <label>Remove Next Contact Date</label>
        <locationX>50</locationX>
        <locationY>1511</locationY>
        <assignmentItems>
            <assignToReference>$Record.Next_Contact_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>FOR_NullDate</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>set_Agent</name>
        <label>set Agent</label>
        <locationX>50</locationX>
        <locationY>803</locationY>
        <assignmentItems>
            <assignToReference>$Record.Agent__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>get_Agent.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Agent_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>get_Agent.PersonEmail</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_Lender</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>set_Date0</name>
        <label>set Expected_Move_In_Date__c</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Expected_Move_In_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>dateFromText</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>get_Agent</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>set_lender</name>
        <label>set lender</label>
        <locationX>50</locationX>
        <locationY>1211</locationY>
        <assignmentItems>
            <assignToReference>$Record.Lender__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.WebFormLenderId__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Lender_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>get_Lender.PersonEmail</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Status_Changed</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>testDate</name>
        <dataType>String</dataType>
        <value>
            <stringValue>2022-06-01</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Guard_Routing_Migration</name>
        <label>Routing Migration</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>set_Date</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Continue</defaultConnectorLabel>
        <rules>
            <name>Routing_Migration_Transfer</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Guard_Routing_Migration_Check</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Stop</label>
        </rules>
    </decisions>
    <decisions>
        <name>Found_Agent</name>
        <label>Found Agent?</label>
        <locationX>182</locationX>
        <locationY>695</locationY>
        <defaultConnector>
            <targetReference>get_Lender</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YES</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_Agent</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_Agent</targetReference>
            </connector>
            <label>YES</label>
        </rules>
    </decisions>
    <decisions>
        <name>Found_Lender</name>
        <label>Found Lender?</label>
        <locationX>182</locationX>
        <locationY>1103</locationY>
        <defaultConnector>
            <targetReference>Is_Status_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YES_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_Lender</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_lender</targetReference>
            </connector>
            <label>YES</label>
        </rules>
    </decisions>
    <decisions>
        <description>check for specific status changes that we need to take action on. Future update would be to call a subflow for determining the Next Contact Date but I don't know if that will accidentally overwrite manual changes being done that trigger this flow (KKnapp 15 Jan, 2026)</description>
        <name>Is_Status_Changed</name>
        <label>Is Status Changed?</label>
        <locationX>182</locationX>
        <locationY>1403</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Changed_to_Closed_Disqualified</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed: Disqualified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed: Disqualified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Next_Contact_Date</targetReference>
            </connector>
            <label>Yes: Closed Disqualified</label>
        </rules>
    </decisions>
    <decisions>
        <description>Set the Lead.Expected_Move_In_Date__c field if the triggering Lead WebFormMoveDate is NOT NULL AND the Lead.Expected_Move_In_Date__c IS NULL (i.e. don't overwrite an existing value.)</description>
        <name>set_Date</name>
        <label>set Expected_Move_In_Date__c Date?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>get_Agent</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>yes0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WebFormMoveDate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Expected_Move_In_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_Date0</targetReference>
            </connector>
            <label>yes</label>
        </rules>
    </decisions>
    <description>added descriptions to components</description>
    <environments>Default</environments>
    <formulas>
        <name>Guard_Routing_Migration_Check</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Permission.VPCS_Routing_Migration},ISCHANGED({!$Record.OwnerId}))</expression>
    </formulas>
    <formulas>
        <name>dateFromText</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.WebFormMoveDate__c})</expression>
    </formulas>
    <formulas>
        <name>FOR_NullDate</name>
        <dataType>Date</dataType>
        <expression>NULL</expression>
    </formulas>
    <interviewLabel>Lead. BeforeUpsert {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead. BeforeUpsert</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>get_Agent</name>
        <label>get Agent</label>
        <locationX>182</locationX>
        <locationY>587</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Found_Agent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsPersonAccount</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WebFormAgentId__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_Lender</name>
        <label>get Lender</label>
        <locationX>182</locationX>
        <locationY>995</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Found_Lender</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WebFormLenderId__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsPersonAccount</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Guard_Routing_Migration</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
