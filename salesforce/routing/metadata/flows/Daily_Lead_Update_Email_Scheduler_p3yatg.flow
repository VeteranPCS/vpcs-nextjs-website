<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Trigger_Send_SMS_Batch_job</name>
        <label>Queue daily regional status SMS</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>VpcsRegionalDailyStatusQueue</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>leads</name>
            <value>
                <elementReference>VAR_LeadsToUpdate</elementReference>
            </value>
        </inputParameters>
        <nameSegment>VpcsRegionalDailyStatusQueue</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <name>Write_Log_Message</name>
        <label>Write Log Message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>LogService</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Query_Leads_for_Status_Update_Email_job</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>className</name>
            <value>
                <stringValue>Schedule Run Subflow QueryLeadsForEmailJob</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>loggingLevel</name>
            <value>
                <stringValue>INFO</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>message</name>
            <value>
                <stringValue>Daily lead email job executed</stringValue>
            </value>
        </inputParameters>
        <nameSegment>LogService</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>65.0</apiVersion>
    <assignments>
        <description>Write all logs at the end to avoid limits</description>
        <name>Add_Log_message_to_collection</name>
        <label>Add Log message to collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_LogMessageEvents</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Send_Agent_Lead_Status_Update_Email.VAR_AppLogMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Next_Contact_Date</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>add_message_to_collection</name>
        <label>add message to collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_LogMessageEvents</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>VAR_LogEvent</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Agent_Lead_Status_Update_Email</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_updated_lead_to_collection</name>
        <label>Add updated lead to collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_LeadsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>For_Each_lead</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>For_Each_lead</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Log_Lead_Details_message</name>
        <label>Log Lead Details message</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_LogEvent.Message__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Lead found for Status email</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_LogEvent.Class__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Schedule Run Subflow QueryLeadsForEmailJob</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_LogEvent.AffectedId__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_Each_lead.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_LogEvent.LogLevel__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>DEBUG</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>add_message_to_collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>If the Agent submits an update form, then the next contact date will be set based on the new stage. Otherwise, send another email tomorrow.</description>
        <name>Set_Next_Contact_Date</name>
        <label>Set Next Contact Date to tomorrow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>For_Each_lead.Next_Contact_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>FOR_TOMORROW</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_updated_lead_to_collection</targetReference>
        </connector>
    </assignments>
    <description>Scheduled flow that runs daily at 9 AM MT for lead email processing.</description>
    <environments>Default</environments>
    <formulas>
        <name>FOR_TOMORROW</name>
        <dataType>Date</dataType>
        <expression>$Flow.CurrentDate + 1</expression>
    </formulas>
    <interviewLabel>Schedule Run Subflow QueryLeadsForEmailJob {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Schedule Daily Lead Update emails</label>
    <loops>
        <name>For_Each_lead</name>
        <label>For Each lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Filter_Leads_by_Active_Agents.VAR_LeadsToOutput</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Log_Lead_Details_message</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Write_Log_Events</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Write_Log_Events</name>
        <label>Write Log Events</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Leads</targetReference>
        </connector>
        <inputReference>VAR_LogMessageEvents</inputReference>
    </recordCreates>
    <recordUpdates>
        <name>Update_Leads</name>
        <label>Update Leads</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Trigger_Send_SMS_Batch_job</targetReference>
        </connector>
        <inputReference>VAR_LeadsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Write_Log_Message</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2025-09-04</startDate>
            <startTime>09:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Filter_Leads_by_Active_Agents</name>
        <label>Filter Leads by Active Agents</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>For_Each_lead</targetReference>
        </connector>
        <flowName>SUB_Filter_Leads_By_OptedIn_Agents</flowName>
        <inputAssignments>
            <name>VAR_LeadsForStatusEmail</name>
            <value>
                <elementReference>Query_Leads_for_Status_Update_Email_job.VAR_NewNotContactedLeads</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <name>Query_Leads_for_Status_Update_Email_job</name>
        <label>Query Leads for Status Update Email job</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Filter_Leads_by_Active_Agents</targetReference>
        </connector>
        <flowName>Query_Leads_for_Status_Update_Email_job</flowName>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <name>Send_Agent_Lead_Status_Update_Email</name>
        <label>Send Agent Lead Status Update Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Add_Log_message_to_collection</targetReference>
        </connector>
        <flowName>SUB_Send_Agent_Lead_Status_Update_Email</flowName>
        <inputAssignments>
            <name>VAR_TriggeringLead</name>
            <value>
                <elementReference>For_Each_lead</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>VAR_LeadsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>VAR_LogEvent</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AppLogEvent__e</objectType>
    </variables>
    <variables>
        <name>VAR_LogMessageEvents</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AppLogEvent__e</objectType>
    </variables>
</Flow>
