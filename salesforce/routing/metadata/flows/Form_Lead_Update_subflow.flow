    <decisions>
        <description>Just in case someone tries to call this flow elsewhere, it won't work if it's not a Lead Update Form__c</description>
        <name>Is_Triggering_Form_a_Lead_Update</name>
        <label>Is Triggering Form a Lead Update?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_TriggeringForm.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lead_Update</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Init_Updated_Lead</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Need_to_preserve_current_Lead_status</name>
        <label>Need to preserve current Lead status?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Target_Lead_Status_from_settings</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, Set target</defaultConnectorLabel>
        <rules>
            <name>PreserveLeadStatus_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_LeadActionSettings.Action_On_Lead_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Preserve_Current</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_existing_Lead</targetReference>
            </connector>
            <label>Yes, Preserve Status</label>
        </rules>
    </decisions>
    <decisions>
        <name>Next_Contact_Date_Action</name>
        <label>What's the Next Contact Date from settings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Should_send_Admin_alert</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>X1_day</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_LeadActionSettings.Next_Contact_Policy__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Add_1_Day</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Next_Contact_Date_1_day</targetReference>
            </connector>
            <label>1 day</label>
        </rules>
        <rules>
            <name>X3_days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_LeadActionSettings.Next_Contact_Policy__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Add_3_Days</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Next_Contact_Date_3_days</targetReference>
            </connector>
            <label>3 days</label>
        </rules>
        <rules>
            <name>X7_days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_LeadActionSettings.Next_Contact_Policy__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Add_7_Days</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_4_of_Set_Next_Contact_Date_7_days</targetReference>
            </connector>
            <label>7 days</label>
        </rules>
        <rules>
            <name>X14_days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_LeadActionSettings.Next_Contact_Policy__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Add_14_Days</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Next_Contact_Date_14_days</targetReference>
            </connector>
            <label>14 days</label>
        </rules>
        <rules>
            <name>X30_days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_LeadActionSettings.Next_Contact_Policy__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Add_30_Days</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Next_Contact_Date_30_days</targetReference>
            </connector>
            <label>30 days</label>
        </rules>
        <rules>
            <name>xRemove_Next_Contact_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_LeadActionSettings.Next_Contact_Policy__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Remove</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Next_Contact_Date</targetReference>
            </connector>
            <label>Remove Next Contact Date</label>
        </rules>
    </decisions>
    <decisions>
        <description>Compares the first value we got from the original settings and the current value. If either one of them requested an email alert, then we should send it.</description>
        <name>Should_send_Admin_alert</name>
        <label>Should send Admin alert?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Should_Send_Status_Specific_Email_Alert</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>SendAdminAlert_Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>VAR_LeadActionSettings.Send_Admin_Email__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>VAR_SendAdminEmail</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_TEST_Admin_email</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Runs regardless of whether the generic admin alert fired, right before the Lead is updated. Gated by Form_Lead_Status_Mapping__mdt.Send_Status_Specific_Email_Alert__c (persisted into VAR_SendStatusSpecificEmail in case Need_to_preserve_current_Lead_status later swaps out VAR_LeadActionSettings).</description>
        <name>Should_Send_Status_Specific_Email_Alert</name>
        <label>Should send status specific email alert?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Triggering_Lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>SendStatusSpecificEmail_Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>VAR_LeadActionSettings.Send_Status_Specific_Email_Alert__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>VAR_SendStatusSpecificEmail</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Status_Specific_Email_Alert_Subflow</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Use_TEST_Admin_email</name>
        <label>Use TEST Admin email?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Resolve_Regional_Admin_Recipients</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_use_test</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_UseTestAdminEmail</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_KNAPPTECH_admin_alert</targetReference>
            </connector>
            <label>Yes, use test</label>
        </rules>
    </decisions>
    <description>Handle the Lead_Update Form__c record type when created.</description>
    <environments>Default</environments>
    <formulas>
        <name>FOR_14DaysDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+14</expression>
    </formulas>
    <formulas>
        <name>FOR_30DaysDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+30</expression>
    </formulas>
    <formulas>
        <name>FOR_3DaysDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+3</expression>
    </formulas>
    <formulas>
        <name>FOR_7DaysDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+7</expression>
    </formulas>
    <formulas>
        <name>FOR_EmailSubject</name>
        <dataType>String</dataType>
        <expression>"Alert: " &amp; {!FOR_NewStatusText}</expression>
    </formulas>
    <formulas>
        <name>FOR_NewStatusText</name>
        <dataType>String</dataType>
        <expression>TEXT({!VAR_TriggeringForm.Lead_Status__c})</expression>
    </formulas>
    <formulas>
        <description>Build note content from Comments, Stages, and other properties.</description>
        <name>FOR_NoteContents</name>
        <dataType>String</dataType>
        <expression>IF({!VAR_TriggeringForm.LeadCurrentStatus__c} = TEXT({!VAR_LeadToUpdate.Status}), 'Status unchanged: ', 'Agent updated the status to: ') + TEXT({!VAR_LeadToUpdate.Status}) + '. ' + BR() + {!VAR_TriggeringForm.Comments__c}</expression>
    </formulas>
    <formulas>
        <name>FOR_NullDate</name>
        <dataType>Date</dataType>
        <expression>NULL</expression>
    </formulas>
    <formulas>
        <name>FOR_TomorrowDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}+1</expression>
    </formulas>
    <interviewLabel>Form: Lead Update subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Form: Lead Update subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Add_a_Note</name>
        <label>Add a Note</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_the_ContentDocumentLink</targetReference>
        </connector>
        <inputReference>VAR_New_EnhancedNote</inputReference>
    </recordCreates>
    <recordCreates>
        <name>Create_the_ContentDocumentLink</name>
        <label>Create the ContentDocumentLink</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>ContentDocumentId</field>
            <value>
                <elementReference>VAR_New_EnhancedNote.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LinkedEntityId</field>
            <value>
                <elementReference>VAR_TriggeringForm.Lead__r.Id</elementReference>
            </value>
        </inputAssignments>
        <object>ContentDocumentLink</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_existing_Lead</name>
        <label>Get existing Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Keep_existing_Lead_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>VAR_LeadToUpdate.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Lead_Status_mapping</name>
        <label>Get Lead Status mapping</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Persist_the_settings_record_so_we_can_refer_to_it_later</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>MasterLabel</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>VAR_TriggeringForm.Lead_Status__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Form_Lead_Status_Mapping__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>** This searches the mapping settings by Target lead Status which is the actual Lead.Status value (not the incoming value from the Form). there will be multiple matches but hopefully, they all have the same Next contact date and Send Adming flag values. This is why we only retrieve the first record.</description>
        <name>Get_Lead_Status_mapping_from_Existing_Status</name>
        <label>Get a new Lead Status mapping from Existing Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Copy_2_of_Persist_the_settings_record_so_we_can_refer_to_it_later</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Target_Lead_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>VAR_LeadToUpdate.Status</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Form_Lead_Status_Mapping__mdt</object>
        <sortField>Target_Lead_Status__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Triggering_Lead</name>
        <label>Update Triggering Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Note_Fields</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>VAR_TriggeringForm.Lead__r.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Next_Contact_Date__c</field>
            <value>
                <elementReference>VAR_LeadToUpdate.Next_Contact_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>VAR_LeadToUpdate.Status</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Updated_by_Agent_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Triggering_Form_a_Lead_Update</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <description>Declaratively branches on the Form's Lead_Status__c to send a dedicated, template-based email alert for specific statuses (currently just AcceptLead). Add new statuses there, not here.</description>
        <name>Send_Status_Specific_Email_Alert_Subflow</name>
        <label>Send Status Specific Email Alert Subflow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Triggering_Lead</targetReference>
        </connector>
        <flowName>SUB_Send_Lead_Status_Specific_Email_Alert</flowName>
        <inputAssignments>
            <name>VAR_TriggeringForm</name>
            <value>
                <elementReference>VAR_TriggeringForm</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>VAR_LeadActionSettings</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Form_Lead_Status_Mapping__mdt</objectType>
    </variables>
    <variables>
        <name>VAR_LeadToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Lead</objectType>
    </variables>
    <variables>
        <name>VAR_New_EnhancedNote</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>ContentNote</objectType>
    </variables>
    <variables>
        <description>When preserving the original Lead.Status we may still want to send an Admin Email. The current Lead.Status may not trigger an email, but the original Form option should have. We'll persiste the original value here and compare it later.</description>
        <name>VAR_SendAdminEmail</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>When preserving the original Lead.Status we may still want to send a status-specific email. The current Lead.Status's mapping may not request one, but the original Form option should have. We'll persist the original value here and compare it later, mirroring VAR_SendAdminEmail.</description>
        <name>VAR_SendStatusSpecificEmail</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>The Form__c record that's triggering this subflow</description>
        <name>VAR_TriggeringForm</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Form__c</objectType>
    </variables>
    <variables>
        <name>VAR_UseTestAdminEmail</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>
