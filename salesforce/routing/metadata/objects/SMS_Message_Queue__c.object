<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Status__c</fullName>
        <description>Current processing status of the SMS message</description>
        <label>Status</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>New</fullName>
                    <default>true</default>
                    <label>New</label>
                </value>
                <value>
                    <fullName>Processing</fullName>
                    <default>false</default>
                    <label>Processing</label>
                </value>
                <value>
                    <fullName>Sent</fullName>
                    <default>false</default>
                    <label>Sent</label>
                </value>
                <value>
                    <fullName>Error</fullName>
                    <default>false</default>
                    <label>Error</label>
                </value>
                <value>
                    <fullName>Retry</fullName>
                    <default>false</default>
                    <label>Retry</label>
                </value>
                <value>
                    <fullName>Held</fullName>
                    <default>false</default>
                    <label>Held</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Event_Key__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <label>Event Key</label>
        <length>160</length>
        <required>false</required>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Expected_Next_Contact__c</fullName>
        <description>Daily status SMS snapshot. An ISO date or NONE is an explicit capture. An empty value is an unverified legacy snapshot.</description>
        <label>Expected Next Contact</label>
        <length>10</length>
        <required>false</required>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Claim_Job_Id__c</fullName>
        <label>Claim Job ID</label>
        <length>18</length>
        <required>false</required>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Related_Lead__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Related Lead</label>
        <referenceTo>Lead</referenceTo>
        <relationshipLabel>Regional SMS Messages</relationshipLabel>
        <relationshipName>Regional_SMS_Messages</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Related_Opportunity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Related Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Regional SMS Messages</relationshipLabel>
        <relationshipName>Regional_SMS_Messages</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Related_Partner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Related Partner</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Regional SMS Messages</relationshipLabel>
        <relationshipName>Regional_SMS_Messages</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
</CustomObject>
