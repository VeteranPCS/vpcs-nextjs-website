  { "label": "Gmail empty after dots", "input": "...@gmail.com", "canonical": null },
  { "label": "Gmail empty after plus", "input": "+tag@gmail.com", "canonical": null },
  { "label": "custom domain base remains distinct", "input": "SeniorRep@example.test", "canonical": "seniorrep@example.test" },
  { "label": "custom domain dots remain distinct", "input": "Senior.Rep@example.test", "canonical": "senior.rep@example.test" },
