  {"label": "domain newline", "input": "name@exam\nple.test", "canonical": null},
  {"label": "inner non-breaking space", "input": "first\u00a0last@example.test", "canonical": null},
  {"label": "Unicode boundary whitespace", "input": "\ufeff\u00a0Name@Example.Test\u202f\u3000", "canonical": "name@example.test"},
